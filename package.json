{
  "name": "agent-arena",
  "version": "0.1.0",
  "description": "Local arena for coding agents: run your own tasks against Claude Code, Codex, Gemini CLI, and local models. Compare diffs, tests, cost, and time.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "arena": "./dist/src/cli.js",
    "agent-arena": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test \"dist/test/**/*.test.js\"",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai-agents",
    "coding-agents",
    "claude-code",
    "codex",
    "gemini-cli",
    "agents",
    "benchmark",
    "evaluation",
    "cli"
  ],
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^26.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuleinist/agent-arena.git"
  }
}